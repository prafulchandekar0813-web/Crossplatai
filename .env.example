# Copy to .env. Environment variables always win over config.json and are never written back to it.
OPENAI_BASE_URL=http://localhost:30000/v1
OPENAI_MODEL=your-model-name
OPENAI_API_KEY=
# ADMIN_PASSWORD=choose-a-strong-one   (if unset, a random one is generated on first start and printed once)
# ADMIN_USERNAME=admin
# SEARCH_PROVIDER=searxng              (searxng or brave; empty disables the web_search tool)
# SEARCH_BASE_URL=http://localhost:8888
# SEARCH_API_KEY=                      (Brave subscription token)
# ALLOW_REGISTRATION=true
# HOST=127.0.0.1
# PORT=8080
